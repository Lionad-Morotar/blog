{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "eslint.useFlatConfig": true,
  "prettier.enable": false,
  "editor.formatOnSave": false,
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off"
    },
    {
      "rule": "format/*",
      "severity": "off"
    },
    {
      "rule": "*-indent",
      "severity": "off"
    },
    {
      "rule": "*-spacing",
      "severity": "off"
    },
    {
      "rule": "*-spaces",
      "severity": "off"
    },
    {
      "rule": "*-order",
      "severity": "off"
    },
    {
      "rule": "*-dangle",
      "severity": "off"
    },
    {
      "rule": "*-newline",
      "severity": "off"
    },
    {
      "rule": "*quotes",
      "severity": "off"
    },
    {
      "rule": "*semi",
      "severity": "off"
    }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "toml"
  ],
  "peacock.color": "#f6c992",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#fae0c1",
    "activityBar.background": "#fae0c1",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#0eb167",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#fae0c1",
    "statusBar.background": "#f6c992",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#f2b263",
    "statusBarItem.remoteBackground": "#0c9356",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#f6c992",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#f6c99299",
    "titleBar.inactiveForeground": "#15202b99",
    "editorGroup.border": "#fae0c1",
    "activityBarTop.activeBackground": "#fae0c1",
    "activityBarTop.background": "#fae0c1",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "statusBar.debuggingBackground": "#f6c992",
    "statusBar.debuggingForeground": "#15202b"
  },
  "cSpell.ignoreWords": [
    "Andrej",
    "ESRGAN",
    "GPTAPI",
    "Ilya",
    "Karpathy",
    "LDSR",
    "SWYX",
    "Smol",
    "Sutskever",
    "qwen"
  ],
