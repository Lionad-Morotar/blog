
{
    /* nuxt ui */
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "editor.quickSuggestions": {
        "strings": true
    },

    /* eslint-configs */
    "eslint.useFlatConfig": true,
    "prettier.enable": false,
    "editor.formatOnSave": false,
    // 静默一些验证规则降低心智负担, 当然还是会 auto fixed
    "eslint.rules.customizations": [
      { "rule": "style/*", "severity": "off" },
      { "rule": "format/*", "severity": "off" },
      { "rule": "*-indent", "severity": "off" },
      { "rule": "*-spacing", "severity": "off" },
      { "rule": "*-spaces", "severity": "off" },
      { "rule": "*-order", "severity": "off" },
      { "rule": "*-dangle", "severity": "off" },
      { "rule": "*-newline", "severity": "off" },
      { "rule": "*quotes", "severity": "off" },
      { "rule": "*semi", "severity": "off" }
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "never"
    },
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "vue",
      "html",
      "markdown",
      "json",
      "jsonc",
      "yaml",
      "toml"
    ],

    /* peacock color */
    "peacock.color": "#d81e06",
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#f93218",
      "activityBar.background": "#f93218",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#025d0d",
      "activityBarBadge.foreground": "#e7e7e7",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#f93218",
      "statusBar.background": "#d81e06",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#f93218",
      "statusBarItem.remoteBackground": "#023e09",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#d81e06",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#d81e0699",
      "titleBar.inactiveForeground": "#e7e7e799",
      "editorGroup.border": "#f93218",
      "activityBarTop.activeBackground": "#f93218",
      "activityBarTop.background": "#f93218",
      "activityBarTop.foreground": "#e7e7e7",
      "activityBarTop.inactiveForeground": "#e7e7e799",
      "commandCenter.foreground": "#e7e7e7",
      "statusBar.debuggingBackground": "#d81e06",
      "statusBar.debuggingForeground": "#e7e7e7"
    },

    /* cspells */
    "cSpell.ignoreWords": [
      "Andrej",
      "ESRGAN",
      "GPTAPI",
      "Ilya",
      "Karpathy",
      "LDSR",
      "SWYX",
